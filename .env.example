# Any long random string. Telegram echoes it back in a header on every webhook
# call; bot.py rejects requests that do not match. Leave blank to disable the
# check (only acceptable for local testing).
TELEGRAM_WEBHOOK_SECRET=

# ---- Model tiers (section 3 of CLAUDE.md) ----
